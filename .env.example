# Postgres (local via docker-compose)
DATABASE_URL="postgresql://events_platform:events_platform@localhost:5433/events_platform?schema=public"

# API
API_PORT=3000

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=90

# QR code signing (HMAC-SHA256)
QR_TOKEN_SECRET="change-me-qr-secret"

# Criptografia (AES-256-GCM) dos dados de conta bancária em repouso — 32 bytes em hex.
# Gerar com: openssl rand -hex 32 (ou node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CONTA_BANCARIA_ENCRYPTION_KEY="change-me-64-hex-chars-32-bytes"

# SMTP para o broadcast de email da tela Participantes — sem isso, o botão "Enviar email aos
# compradores" falha com um erro claro (não finge que enviou). Qualquer provedor SMTP serve.
# MAIL_HOST="smtp.exemplo.com"
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER="usuario@exemplo.com"
# MAIL_PASS="senha-ou-api-key"
# MAIL_FROM="RARO Tickets <nao-responda@exemplo.com>"

# Next.js (apps/web)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Expo (apps/mobile)
EXPO_PUBLIC_API_URL="http://localhost:3000"
