generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelGlobal {
  usuario
  admin_geral
}

enum PapelEvento {
  owner
  gestor
  view
  checkin_operator
}

enum StatusIngresso {
  pendente
  valido
  usado
  cancelado
}

enum TaxaPagaPor {
  comprador
  organizador
}

enum CategoriaEvento {
  shows
  festivais
  negocios
  esportes
  cursos
  tecnologia
  outros
}

enum EscopoAcordoComercial {
  todos_eventos
  evento_especifico
  proximos_n_eventos
}

enum TipoPessoa {
  fisica
  juridica
}

enum TipoDescontoCupom {
  percentual
  valor_fixo
}

model Usuario {
  id              String      @id @default(uuid())
  nome            String
  email           String      @unique
  senhaHash       String
  papelGlobal     PapelGlobal @default(usuario)
  tipoPessoa      TipoPessoa  @default(fisica)
  /// CPF (pessoa física) ou CNPJ (pessoa jurídica) — só dígitos, validado por dígito verificador no registerSchema.
  documento       String      @unique
  /// Só pessoa física — empresa não tem data de nascimento.
  dataNascimento  DateTime?
  asaasSubcontaId String?
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt

  papeisAcesso      PapelAcesso[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  acordosComerciais AcordoComercial[] @relation("AcordoComercialOrganizador")
  acordosDefinidos  AcordoComercial[] @relation("AcordoComercialAdmin")

  @@map("usuarios")
}

enum TipoContaBancaria {
  corrente
  poupanca
}

/// Refresh token opaco (guardado como hash) com rotação e janela deslizante — ver docs/architecture/07 e a fatia de implementação auth.
model RefreshToken {
  id         String    @id @default(uuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  familyId   String
  criadoEm   DateTime  @default(now())
  expiraEm   DateTime
  revogadoEm DateTime?
  ip         String?
  userAgent  String?

  @@index([usuarioId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PapelAcesso {
  id        String      @id @default(uuid())
  usuarioId String
  usuario   Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  eventoId  String
  evento    Evento      @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  papel     PapelEvento
  criadoEm  DateTime    @default(now())

  @@unique([usuarioId, eventoId])
  @@map("papeis_acesso")
}

model Evento {
  id           String      @id @default(uuid())
  nome         String
  data         DateTime
  /// Opcional — evento sem horário de término definido ainda é válido (ex: sem hora certa pra acabar).
  dataFim      DateTime?
  local        String
  cidade       String?
  estado       String?
  pais         String?
  /// Endereço detalhado — exibido sempre como "cidade, estado - rua + número + complemento, bairro - CEP: xxxxx-xxx" (ver formatarEnderecoEvento em shared-types).
  rua          String?
  numero       String?
  complemento  String?
  bairro       String?
  cep          String?
  /// Classificação etária — true = evento só pra maiores de 18.
  somenteMaioresDeIdade Boolean @default(false)
  categoria    CategoriaEvento @default(outros)
  transferivel Boolean     @default(false)
  /// Só tem efeito quando transferivel=true. null = sem limite de prazo (pode transferir até o início do evento).
  /// Quando setado, bloqueia transferência se agora > (data do evento - prazoTransferenciaHoras).
  prazoTransferenciaHoras Int?
  taxaPagaPor  TaxaPagaPor @default(comprador)
  /// Banner do evento salvo como bytes direto no Postgres (bytea), não em storage externo/URL — decisão explícita do produto. Ver docs/architecture/04-modelo-de-dados.md.
  imagemBanner     Bytes?
  imagemBannerTipo String?
  /// O evento existe por completo independente disso — este campo só controla se COMPRADORES já enxergam ele em GET /events/public. Privado (false) por padrão; só quem tem PapelAcesso enxerga até o organizador liberar (e pode tornar privado de novo depois).
  publicado       Boolean @default(false)
  descricao       String?
  contatoNome     String?
  contatoEmail    String?
  contatoTelefone String?
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt

  lotes             Lote[]
  linksVenda        LinkVenda[]
  papeisAcesso      PapelAcesso[]
  ingressos         Ingresso[]
  listaOff          ListaOff[]
  acordosComerciais AcordoComercial[]
  contaBancaria     ContaBancaria?
  cupons            CupomDesconto[]

  @@map("eventos")
}

/// Cupom de desconto por evento — percentual (ex: 10%) ou valor fixo (ex: R$ 20). Aplicado só na
/// futura fatia de checkout (ainda não existe compra paga self-service); por enquanto é só o
/// cadastro/gestão do cupom em si.
model CupomDesconto {
  id       String            @id @default(uuid())
  eventoId String
  evento   Evento            @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  codigo   String
  tipo     TipoDescontoCupom
  valor    Decimal           @db.Decimal(10, 2)
  ativo    Boolean           @default(true)
  /// null = ilimitado (padrão). Quando setado, emitir um ingresso com esse cupom passa a ser bloqueado
  /// assim que usos >= limiteUsos — ver CupomEsgotadoException.
  limiteUsos Int?
  /// Cupom especial (protegido por senha) — pensado pra dar acesso a lotes especiais (Lote.especial).
  /// Nunca retornado em nenhuma resposta da API; só usado para verificar a senha no desbloqueio público.
  especial   Boolean  @default(false)
  senhaHash  String?
  /// Incrementado quando um ingresso é emitido já apontando pra esse cupom (ver Ingresso.cupomDescontoId)
  /// e decrementado se esse ingresso for cancelado — ainda não conta vendas via checkout self-service
  /// (que não existe), só emissão manual que o organizador marcou como tendo usado o cupom.
  usos     Int               @default(0)
  criadoEm DateTime          @default(now())

  ingressos Ingresso[]

  @@unique([eventoId, codigo])
  @@map("cupons_desconto")
}

/// Conta de repasse — por EVENTO, não por organizador: o mesmo organizador pode rodar eventos
/// com contas de repasse diferentes (ex: evento em parceria com outro CNPJ). Cadastrada na 2ª
/// etapa da criação do evento — ver docs/architecture/09-modelo-financeiro.md e
/// apps/web/app/eventos/novo/conta-repasse/page.tsx. Guarda os dados brutos por enquanto; quando
/// o gateway (Asaas) entrar na fatia de checkout, esse cadastro passa a disparar a criação da
/// subconta correspondente no gateway.
model ContaBancaria {
  id               String            @id @default(uuid())
  eventoId         String            @unique
  evento           Evento            @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  banco            String
  agencia          String
  conta            String
  tipoConta        TipoContaBancaria
  titular          String
  documentoTitular String
  criadoEm         DateTime          @default(now())
  atualizadoEm     DateTime          @updatedAt

  @@map("contas_bancarias")
}

model Lote {
  id         String   @id @default(uuid())
  eventoId   String
  evento     Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  nome       String
  preco      Decimal  @db.Decimal(10, 2)
  quantidade Int
  /// Lote especial/privado — pensado pra só ficar visível/comprável através de um cupom especial com senha.
  especial   Boolean  @default(false)
  criadoEm   DateTime @default(now())

  ingressos Ingresso[]

  @@map("lotes")
}

model LinkVenda {
  id       String   @id @default(uuid())
  eventoId String
  evento   Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  slug     String
  origem   String
  criadoEm DateTime @default(now())

  ingressos Ingresso[]

  @@unique([eventoId, slug])
  @@map("links_venda")
}

/// version: lock otimista usado pelo módulo checkin (fatia futura) para impedir dupla validação de QR em corrida.
model Ingresso {
  id           String         @id @default(uuid())
  eventoId     String
  evento       Evento         @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  loteId       String
  lote         Lote           @relation(fields: [loteId], references: [id], onDelete: Cascade)
  linkVendaId  String?
  linkVenda    LinkVenda?     @relation(fields: [linkVendaId], references: [id])
  /// Cupom que o organizador marcou como usado nesta emissão (opcional) — ver CupomDesconto.usos.
  cupomDescontoId String?
  cupomDesconto   CupomDesconto? @relation(fields: [cupomDescontoId], references: [id])
  status       StatusIngresso @default(valido)
  qrToken      String         @unique
  transferivel Boolean        @default(false)
  /// Cancelamento flexível — comprador pode cancelar a qualquer momento até perto do início do evento
  /// (ver TicketsService.cancelarSeProprio), em vez da janela padrão de 7 dias corridos da emissão.
  /// Marcado pelo organizador na emissão manual — não há cobrança real do adicional de 10% associado
  /// a essa opção, já que não existe checkout/pagamento implementado (ver docs/architecture/12-pagamentos-e-repasses.md#43).
  cancelamentoFlexivel Boolean @default(false)
  version      Int            @default(0)
  /// Preenchidos na emissão manual — ainda não existe checkout self-service, então nem todo ingresso tem comprador (ex: cortesias sem contato coletado). compradorEmail é o que liga um ingresso ao 'Meus ingressos' de um Usuario.
  compradorNome      String?
  compradorEmail     String?
  compradorDocumento String?
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt

  transacao Transacao?

  @@map("ingressos")
}

model Transacao {
  id         String   @id @default(uuid())
  ingressoId String   @unique
  ingresso   Ingresso @relation(fields: [ingressoId], references: [id], onDelete: Cascade)
  gateway    String
  status     String
  valor      Decimal  @db.Decimal(10, 2)
  metodo     String
  criadoEm   DateTime @default(now())

  @@map("transacoes")
}

model ListaOff {
  id        String    @id @default(uuid())
  eventoId  String
  evento    Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  cpf       String
  statusUso Boolean   @default(false)
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  @@unique([eventoId, cpf])
  @@map("lista_off")
}

model FeatureFlag {
  id            String   @id @default(uuid())
  chave         String   @unique
  ativo         Boolean  @default(false)
  eventosEscopo String[] @default([])
  criadoEm      DateTime @default(now())

  @@map("feature_flags")
}

model AuditLog {
  id          String   @id @default(uuid())
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  acao        String
  entidade    String
  entidadeId  String
  dispositivo String?
  ip          String?
  criadoEm    DateTime @default(now())

  @@index([entidade, entidadeId])
  @@map("audit_logs")
}

/// Divisão dos 12% de taxa de serviço entre NOVYX e organizador — ver docs/architecture/09-modelo-financeiro.md.
model AcordoComercial {
  id                    String                 @id @default(uuid())
  organizadorId         String
  organizador           Usuario                @relation("AcordoComercialOrganizador", fields: [organizadorId], references: [id])
  eventoId              String?
  evento                Evento?                @relation(fields: [eventoId], references: [id])
  percentualNovyx       Decimal                @db.Decimal(5, 2)
  percentualOrganizador Decimal                @db.Decimal(5, 2)
  escopo                EscopoAcordoComercial
  eventosRestantes      Int?
  ativo                 Boolean                @default(true)
  definidoPorAdminId    String
  definidoPorAdmin      Usuario                @relation("AcordoComercialAdmin", fields: [definidoPorAdminId], references: [id])
  criadoEm              DateTime               @default(now())

  @@map("acordos_comerciais")
}
