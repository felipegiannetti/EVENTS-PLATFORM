# Postgres (local via docker-compose)
DATABASE_URL="postgresql://events_platform:events_platform@localhost:5433/events_platform?schema=public"

# API
API_PORT=3000

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=90

# QR code signing (HMAC-SHA256)
QR_TOKEN_SECRET="change-me-qr-secret"

# Next.js (apps/web)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Expo (apps/mobile)
EXPO_PUBLIC_API_URL="http://localhost:3000"
